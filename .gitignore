# Run outputs land in result/<YYYYMMDD_HHMMSS>/ and are never published.
# Prompt files stay in data/ (git-tracked); the data/* + negation lines below
# are kept as a safety net against accidental writes there -- negation works
# because the pattern excludes the CONTENTS of data/ (data/*), not the
# data/ directory itself -- an ignored directory cannot be negated into.
result/
data/*
!data/prompts.json
!data/prompts.arith.deep.json
!data/prompts.math.deep.json
!data/prompts.words.deep.json

# local debris / scratch
.DS_Store
__pycache__/
*.pyc
.audit.*
